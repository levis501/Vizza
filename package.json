{
    "name": "Vizza",
    "private": true,
    "version": "0.11.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "eslint . --ext .svelte,.js,.ts",
        "format": "prettier --write .",
        "test": "vitest run",
