        "test:wgsl": "vitest run test/wgsl",
        "test:gpu": "node test/gpu/run.mjs",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@playwright/test": "^1.62.1",
        "@tsconfig/svelte": "^5.0.4",
